# Generate unique tokens separately: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Placeholders intentionally cannot start a safe hub.
METRICS_ADMIN_TOKEN=REPLACE_WITH_RANDOM_48_PLUS_CHARACTERS
METRICS_AGENT_TOKENS='{"host-a":"REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_CHARACTERS"}'
METRICS_DB_PATH=./data/metrics.sqlite3
METRICS_ALLOWED_ORIGINS=
# Optional alert thresholds; defaults shown
METRICS_ALERT_CPU_PERCENT=90
METRICS_ALERT_MEMORY_PERCENT=90
METRICS_ALERT_DISK_PERCENT=90
METRICS_ALERT_OFFLINE_SECONDS=120
# External webhook delivery is disabled unless deliberately opted in.
# METRICS_WEBHOOK_URL=https://your-owned-https-endpoint.example/api/events
# METRICS_WEBHOOK_BEARER=
# Rolling host/container history; startup validates range 1-365 days
METRICS_RETENTION_DAYS=30
